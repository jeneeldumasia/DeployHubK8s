MONGO_URI=mongodb://mongo:27017/deployhub
MONGO_DB_NAME=deployhub
PUBLIC_BASE_URL=http://localhost
BACKEND_VERSION=2.0.0
PORT_RANGE_START=3001
PORT_RANGE_END=3999
CORS_ORIGINS=*

# Deployment mode: "docker" for local, "k8s" for Kubernetes
DEPLOYMENT_MODE=docker

# GitHub webhook signature verification (set this in GitHub repo settings too)
GITHUB_WEBHOOK_SECRET=

# ECR registry URL for k8s mode (e.g. 123456789.dkr.ecr.us-east-1.amazonaws.com)
ECR_REGISTRY=
